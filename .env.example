# Public URL of this panel (must match Authentik redirect base)
NEXTAUTH_URL=https://stoat-admin.dataknife.net
NEXTAUTH_SECRET=

# Authentik OAuth2/OIDC application
# Redirect URI: ${NEXTAUTH_URL}/api/auth/callback/authentik
AUTHENTIK_ID=
AUTHENTIK_SECRET=
# No trailing slash
AUTHENTIK_ISSUER=https://auth.dataknife.net/application/o/stoat-admin

# Stoat Mongo (operator sets MONGODB=mongodb://database)
MONGODB=mongodb://127.0.0.1:27017
MONGODB_DB=revolt

# Optional — Stoat user ULID for platform actions (reserved)
PLATFORM_ACCOUNT_ID=

HOST=0.0.0.0
PORT=3000
